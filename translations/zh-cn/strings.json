  "spell.0.description": "用人到自己身上的血恢体力",
  "spell.0.name": "嗜血咒",
  "spell.1.description": "召凶猛的鬼魂",
  "spell.1.name": "招魂",
  "spell.2.description": "空移后火攻",
  "spell.2.name": "地之火",
  "spell.3.description": "一次招出四个鬼魂",
  "spell.3.name": "四魂附体",
  "spell.4.description": "狼以身体冲撞的力攻",
  "spell.4.name": "狼之冲撞",
  "spell.5.description": "取附近人的体力",
  "spell.5.name": "吸魂",
  "spell.6.description": "蝙蝠以身体冲撞的力攻",
  "spell.6.name": "蝠翼冲",
  "spell.7.description": "召魔分身",
  "spell.7.name": "魔兄弟",
  "text.lib.144": "１７９２年（５年前）被@里希特打的魔城城主",
  "text.lib.143": "吸收了大量的血，即使被打倒了@也能自活的",
  "text.lib.142": "吸血蝙蝠@吸血鬼的仆人，令人感到恐惧",
  "text.lib.141": "魔力化而无法破坏的盖骨",
  "text.lib.140": "被魔法操的僵尸",
  "text.lib.139": "水栖人，喜靠近水的物",
  "text.lib.138": "被魔法所操的成白骨的尸体",
  "text.lib.137": "守魔城入口的狼",
  "text.lib.136": "勇猛的士",
  "text.lib.135": "能从口中吐出力火的半人@外形体格巨大",
  "text.lib.134": "口里不断流出酸性液体@的四脚沿着壁移",
  "text.lib.133": "身穿青甲的低装甲斧兵",
  "text.lib.132": "３００年前正教会派出的@全覆没于魔城中",
  "text.lib.131": "把肋骨当的",
  "text.lib.130": "被施以降而四旋的子",
  "text.lib.129": "使用回旋的兵",
  "text.lib.128": "叶片利如刀的植物",
  "text.lib.127": "死神直属的魔士，口吐火@擅空中攻",
  "text.lib.126": "周着奇能量的亡",
  "text.lib.125": "四游找着真正的肉体@有邪意志的人偶",
  "text.lib.124": "死神直属的魔士，@使用魔擅地面攻",
  "text.lib.123": "有前后个的双怪物@很分辨是是尾",
  "text.lib.122": "会像跳蚤一跳的怪人",
  "text.lib.121": "从美杜莎的滋生而来@被大量制的美杜莎的分身",
  "text.lib.120": "正在苦二刀流的兵",
  "text.lib.119": "使用火的士兵",
  "text.lib.118": "从美杜莎的滋生而来@具有石化能力的美杜莎的分身",
  "text.lib.117": "使用巨大球的重兵",
  "text.lib.116": "狂暴化的食虫植物，@到它的子会被石化",
  "text.lib.115": "使用斧的重装兵@由于也装了盾，防御并没有漏洞",
  "text.lib.114": "会操冷气与火的魔@看上去似乎缺少些干",
  "text.lib.113": "使用弓箭的射手",
  "text.lib.112": "用成化石的恐白骨@做成子的装品",
  "text.lib.111": "成被狙的牲者的姿@四人人的魔",
  "text.lib.110": "住在魔城附近森林里的猫@因受魔城邪气的影而得狂暴",
  "text.lib.109": "在断台上被决的士兵的首@成怨后在城内四游找身躯",
  "text.lib.108": "寄生于海斯拉的海蛇",
  "text.lib.107": "成白骨的猿猴尸体，被魔法所操",
  "text.lib.106": "使用的甲兵",
  "text.lib.105": "着初咒的",
  "text.lib.104": "能在空中行的兵@由数白骨合而成",
  "text.lib.103": "从充怨恨的尸体中出的棉状物",
  "text.lib.102": "手持大以常的兵",
  "text.lib.101": "在安息日接受了魔的@洗礼而巨大化的青蛙",
  "text.lib.100": "用从古代上的无数尸体中@的猛将的尸体所制造的重装兵",
  "text.lib.99": "擅在地形劣的地方斗的甲兵",
  "text.lib.98": "被下的士成白骨的尸体@擅使用刺",
  "text.lib.97": "呼凶兆的邪的青蛙",
  "text.lib.96": "操冷气的亡",
  "text.lib.95": "古代的武器典",
  "text.lib.94": "因大的力而巨大化的亡",
  "text.lib.93": "人的味道非常敏感的邪",
  "text.lib.92": "因魔城的魔力，@死后仍在行浅色的幽",
  "text.lib.91": "使用柄流星的兵",
  "text.lib.90": "着特的跳蚤男",
  "text.lib.89": "有邪意志的@喜出怪声来制造混乱",
  "text.lib.88": "使用柄斧的兵",
  "text.lib.87": "有恐怖的相貌与同@丑陋的心的海",
  "text.lib.86": "形的女手之",
  "text.lib.85": "寄宿着亡魂的泥人偶",
  "text.lib.84": "随都与形影不@和手作的高兵",
  "text.lib.83": "大兵着于利的怨念@死后也会",
  "text.lib.82": "武装了甲和斧的跳蚤男",
  "text.lib.81": "有与子的身体@和老翅膀的怪",
  "text.lib.80": "巨人兵",
  "text.lib.79": "具有状物形的怪物",
  "text.lib.78": "操使二刀流的秀士兵",
  "text.lib.77": "成白骨的人的尸体",
  "text.lib.76": "看守墓而磨自己的男人",
  "text.lib.75": "身体灼，喜到放火的鬼",
  "text.lib.74": "具有丑女面孔和身体的怪",
  "text.lib.73": "牛人身的怪物",
  "text.lib.72": "由狼身而成的人",
  "text.lib.71": "与兵合之后能移的骨架@无与比的合",
  "text.lib.70": "死后仍然望斗的兵",
  "text.lib.69": "靠魔力浮在空中，@能自由操刀身披斗篷的怪人",
  "text.lib.68": "寄宿着守水的使者的魂@凶猛的古代的化石",
  "text.lib.67": "擅魔法身材矮小的魔@只要入侵者就召仆人行攻",
  "text.lib.66": "死者的墓掌点松明灯的怪人@草和宝石的用非常了解",
  "text.lib.65": "来自塞勒姆的幽女巫",
  "text.lib.64": "使用２把短的甲兵",
  "text.lib.63": "使用廓喀弯刀的甲兵",
  "text.lib.62": "能松使用巨大的甲兵",
  "text.lib.61": "使用形的残虐甲兵",
  "text.lib.60": "掌握着暗的力量，以形@出的魔",
  "text.lib.59": "具有状物形的怪物",
  "text.lib.58": "具有独角外形的魔@有着地的音家的称号",
  "text.lib.57": "地看狗",
  "text.lib.56": "凶猛的古代，@主要栖息于地下洞穴肉很好吃",
  "text.lib.55": "有大魔力的吸血鬼@在魔城中有着高的地位",
  "text.lib.54": "魅魔，@成莉莎的子想欺阿多",
  "text.lib.53": "寄宿着死者怨念的墓碑，@活人",
  "text.lib.52": "吸食刑者的血而成的@妖草奈",
  "text.lib.51": "与少女一起迷路了的胆小的子",
  "text.lib.50": "途末路没能逃掉的残兵将@一直追着自己流出失的髓",
  "text.lib.49": "分身很多，但只有一个主体",
  "text.lib.48": "没有名字的妖怪，Ｑ是它的称@看了会得它很可",
  "text.lib.47": "没有心的机器人，因此而不知道恐惧",
  "text.lib.46": "体内藏有毒胞子的植物",
  "text.lib.45": "永追逐着自己的@一生都在不停奔的",
  "text.lib.44": "投炸的甲兵",
  "text.lib.43": "即使身体被切碎了也能@不死性的僵尸",
  "text.lib.42": "通魔法得到透明能力的怪虫@只有有魔力的人才能看到它",
  "text.lib.41": "把全身的骨都当成@乱一气的兵",
  "text.lib.40": "信仰魔，找活祭品的弓兵",
  "text.lib.39": "从魔界得新生力量的狼人",
  "text.lib.38": "能化身豹的液体生物",
  "text.lib.37": "恐怖的巨型蝙蝠@吸血鬼的化身",
  "text.lib.36": "以白骨架坐的跳蚤男",
  "text.lib.35": "从魔界得新生力量的牛怪",
  "text.lib.34": "通穿孔式得超能力@上有洞的法",
  "text.lib.33": "被跳蚤男操的白蛇神",
  "text.lib.32": "被注入邪魂的恐化石",
  "text.lib.31": "能吐出灼火的狼",
  "text.lib.30": "投岩石的甲兵",
  "text.lib.29": "曾射暴君阿拉里克的神之射手",
  "text.lib.28": "一看人就来的",
  "text.lib.27": "以火之狼坐的兵",
  "text.lib.26": "用的舌出家畜的内@未知的吸血物",
  "text.lib.25": "因暗魔力而狂暴化的章",
  "text.lib.24": "从地出来的炎之魔",
  "text.lib.23": "有甲一般青皮的怪牛",
  "text.lib.22": "邪神，太古的支配者@所有看到他的人都会感到恐惧",
  "text.lib.21": "从古代墓地出来@被成木乃伊的尸体",
  "text.lib.20": "吸取世界生物的血而成，@凶的阿拉奈",
  "text.lib.19": "能放出石化的蛇女",
  "text.lib.18": "用大士的尸@而成的人造人",
  "text.lib.17": "成格特・斯蒂的子@想欺阿多的僵尸",
  "text.lib.16": "成特雷弗・蒙特的子@想欺阿多的僵尸",
  "text.lib.15": "淘气的小魔",
  "text.lib.14": "成法・迪斯的子@想欺阿多的僵尸",
  "text.lib.13": "之王西卜@最近正毛越来越少而",
  "text.lib.12": "地里行死刑的魔神",
  "text.lib.11": "操冷气的新混血@加拉莫斯的属下",
  "text.lib.10": "会使用魔法的女孩子@昵称是「小魔女」",
  "text.lib.9": "神秘失踪后不知去向@最的吸血鬼人",
  "text.lib.8": "很罕的一@一看人就会迅速逃掉",
  "text.lib.7": "用一万年得到魔@界之王宝座的魔神",
